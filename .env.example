# ==============================================================================
# Social Media Controller - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# NOTE: If credentials are left blank, the Social Media Controller runs in
# "Simulation / Sandbox Mode", allowing full local testing without real API keys.
# ==============================================================================

# Flask Application Settings
FLASK_APP=main.py
FLASK_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# 1. X (formerly Twitter) Developer API (OAuth 1.0a & v2)
# Developer Portal: https://developer.x.com/en/portal/dashboard
# Required Permissions: Read and Write, Direct Messages (optional)
# ------------------------------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# ------------------------------------------------------------------------------
# 2. Meta Facebook Pages (Graph API v20.0)
# Meta for Developers: https://developers.facebook.com
# Required Scopes: pages_manage_posts, pages_read_engagement, pages_show_list
# ------------------------------------------------------------------------------
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. Instagram Business / Creator (Meta Graph API v20.0)
# Meta for Developers: https://developers.facebook.com
# Required Scopes: instagram_basic, instagram_content_publish
# Note: INSTAGRAM_ACCOUNT_ID is the Instagram Business Account ID (IG User ID)
# ------------------------------------------------------------------------------
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 4. Meta Threads (Threads API v1.0)
# Meta Threads API: https://developers.facebook.com/docs/threads
# Required Scopes: threads_basic, threads_content_publish
# ------------------------------------------------------------------------------
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 5. TikTok Content Posting API (v2)
# TikTok for Developers: https://developers.tiktok.com
# Required Scopes: video.publish, video.upload
# ------------------------------------------------------------------------------
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
